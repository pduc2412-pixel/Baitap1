@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="hero">
    <a class="hero-thumb" href="#">
        <img src="https://picsum.photos/id/1036/1200/900" alt="Toàn cảnh sông Hồng" />
    </a>
    <div class="hero-body">
        <h1><a href="#">'Ưu tiên tái định cư trước khi triển khai Trục cảnh quan sông Hồng'</a></h1>
        <p class="lead">
            Hà Nội sẽ ưu tiên xây dựng các khu tái định cư trước khi triển khai Trục Đại lộ cảnh quan
            sông Hồng - dự án hơn 11.400 ha, liên quan khoảng 247.000 dân ven sông, thực hiện giai đoạn 2026-2038.
        </p>
        <span class="time">1h trước</span>
    </div>
</section>

<section class="row-3">
    <article class="card">
        <h2><a href="#">Hà Nội giải phóng mặt bằng cho hơn 1.400 dự án</a></h2>
        <a class="card-thumb" href="#">
            <img src="https://picsum.photos/id/1076/800/600" alt="Máy xúc phá dỡ công trình" />
        </a>
    </article>

    <article class="card">
        <h2><a href="#">TP HCM siết kiểm soát người nhập cảnh phòng Ebola</a></h2>
        <a class="card-thumb" href="#">
            <img src="https://picsum.photos/id/1067/800/600" alt="Hành khách tại sân bay" />
        </a>
    </article>

    <aside class="opinion">
        <span class="opinion-tag">Góc nhìn</span>
        <h3><a href="#">'Bóc lột' trên YouTube</a></h3>
        <p>Khi cỗ máy Content ID của YouTube bị trục lợi, nhiều nghệ s...</p>
        <div class="opinion-meta">
            <em>Hoàng Hà</em>
            <span class="comment">
                <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                    <path d="M2 3h12v8H6l-4 3z" fill="currentColor"/>
                </svg>
                24
            </span>
        </div>
    </aside>
</section>
